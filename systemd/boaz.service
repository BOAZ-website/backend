[Unit]
  Description=BOAZ Backend API Server
  After=network-online.target
  Wants=network-online.target
  StartLimitIntervalSec=60
  StartLimitBurst=3

  [Service]
  Type=simple
  User=boaz
  Group=boaz
  WorkingDirectory=/opt/boaz

  PermissionsStartOnly=true
  ExecStartPre=/opt/boaz/scripts/load-ssm-env.sh
  EnvironmentFile=/run/boaz/app.env
  Environment=SPRING_PROFILES_ACTIVE=prod

  ExecStart=/opt/boaz/scripts/start.sh

  KillSignal=SIGTERM
  KillMode=mixed
  TimeoutStopSec=30
  SuccessExitStatus=143

  Restart=on-failure
  RestartSec=10

  NoNewPrivileges=true
  PrivateTmp=true
  ProtectSystem=strict
  ProtectHome=true
  ReadWritePaths=/opt/boaz/logs /run/boaz /var/log/boaz

  StandardOutput=journal
  StandardError=journal
  SyslogIdentifier=boaz

  [Install]
  WantedBy=multi-user.target

