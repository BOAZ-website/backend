[Unit]
Description=BOAZ Backend API Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=boaz
Group=boaz
WorkingDirectory=/opt/boaz

ExecStart=/opt/boaz/scripts/start.sh

KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=30
SuccessExitStatus=143

Restart=on-failure
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/boaz/logs /run/boaz /var/log/boaz

StandardOutput=journal
StandardError=journal
SyslogIdentifier=boaz

[Install]
WantedBy=multi-user.target
